# Copy to .env and adjust. All values have safe development defaults.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC
# SQLITE_PATH=/absolute/path/db.sqlite3
# MEDIA_ROOT=/absolute/path/media

# Domain tuning
TAMS_INCIDENT_FRESHNESS_MINUTES=60
TAMS_VERIFICATION_THRESHOLD=3
TAMS_CLEARED_THRESHOLD=3
TAMS_EXPIRY_SWEEP_INTERVAL_SECONDS=60
TAMS_NOTIFICATION_POLL_MS=30000
TAMS_ROUTE_BUFFER_M=300
TAMS_NEARBY_RADIUS_KM=10

# Map tiles (any XYZ provider). Default is OpenStreetMap standard tiles.
# TAMS_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
# TAMS_MAP_TILE_ATTRIBUTION=&copy; OpenStreetMap contributors &copy; CARTO

# Database (default SQLite). For PostgreSQL: pip install "psycopg[binary]" and set:
# DB_ENGINE=postgres
# DB_NAME=tams
# DB_USER=tams
# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432

# Logging level for the "core" logger (DEBUG, INFO, WARNING)
# TAMS_LOG_LEVEL=INFO
